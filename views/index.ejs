        const marketData = {
            btc_idr: { name: 'BTC / IDR', price: 1450000000, step: 2500000 },
            eth_idr: { name: 'ETH / IDR', price: 54000000, step: 100000 },
            xrp_idr: { name: 'XRP / IDR', price: 9800, step: 30 },
            doge_idr: { name: 'DOGE / IDR', price: 3450, step: 15 },
            sol_idr: { name: 'SOL / IDR', price: 2950000, step: 15000 }
        };

        window.onload = function() {
            changeMarketPair();
            initChart();
            checkApiConnection(); 
            // Tes kirim notifikasi saat halaman dibuka
            sendTelegramAlert("🚀 *[VVIP ENGINE CONNECTED]* Dashboard Indodax Quant Bot berhasil dimuat & terhubung ke Telegram!");
        };

        function switchChartType(type) {
            const eqContainer = document.getElementById('container-equity');
            const candleContainer = document.getElementById('container-candle');
            const btnEq = document.getElementById('btn-chart-equity');
            const btnCandle = document.getElementById('btn-chart-candle');

            if(type === 'equity') {
                eqContainer.classList.remove('hidden');
                candleContainer.classList.add('hidden');
                btnEq.className = 'flex-1 py-1.5 text-xs font-semibold rounded-lg bg-cyan-500 text-black transition';
                btnCandle.className = 'flex-1 py-1.5 text-xs font-semibold rounded-lg text-gray-400 hover:text-white transition';
            } else {
                eqContainer.classList.add('hidden');
                candleContainer.classList.remove('hidden');
                btnCandle.className = 'flex-1 py-1.5 text-xs font-semibold rounded-lg bg-emerald-500 text-black transition';
                btnEq.className = 'flex-1 py-1.5 text-xs font-semibold rounded-lg text-gray-400 hover:text-white transition';
                if (!isCandleInitialized) {
                    initCandleChart();
                    isCandleInitialized = true;
                } else if (tvChart) {
                    const container = document.getElementById('candlestick-div');
                    tvChart.applyOptions({ width: container.clientWidth, height: container.clientHeight || 224 });
                    tvChart.timeScale().fitContent();
                }
            }
        }

        function initCandleChart() {
            const container = document.getElementById('candlestick-div');
            container.innerHTML = '';
            tvChart = LightweightCharts.createChart(container, {
                width: container.clientWidth || 600,
                height: 224,
                layout: { background: { type: 'solid', color: '#0b0f19' }, textColor: '#9ca3af' },
                grid: { vertLines: { color: 'rgba(255, 255, 255, 0.03)' }, horzLines: { color: 'rgba(255, 255, 255, 0.03)' } },
                timeScale: { timeVisible: true, secondsVisible: true }
            });
            candleSeries = tvChart.addCandlestickSeries({
                upColor: '#10b981', downColor: '#f43f5e', borderDownColor: '#f43f5e', borderUpColor: '#10b981', wickDownColor: '#f43f5e', wickUpColor: '#10b981'
            });

            let baseTime = Math.floor(Date.now() / 1000) - 300;
            let price = currentPrice;
            let initialData = [];
            for(let i = 0; i < 20; i++) {
                let open = price + (Math.random() - 0.5) * 100000;
                let close = open + (Math.random() - 0.5) * 100000;
                let high = Math.max(open, close) + Math.random() * 50000;
                let low = Math.min(open, close) - Math.random() * 50000;
                initialData.push({ time: baseTime + (i * 10), open, high, low, close });
                price = close;
            }
            candleSeries.setData(initialData);
            tvChart.timeScale().fitContent();
        }

        async function checkApiConnection() {
            try {
                const response = await fetch('/api/check-connection');
                const data = await response.json();
                const badge = document.getElementById('bot-status-badge');
                if (data.connected) {
                    badge.className = 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 px-3.5 py-1.5 rounded-xl text-xs font-semibold flex items-center gap-2';
                    badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> CONNECTED (VVIP LIVE)';
                } else {
                    badge.className = 'bg-rose-500/10 text-rose-400 border border-rose-500/30 px-3.5 py-1.5 rounded-xl text-xs font-semibold flex items-center gap-2';
                    badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-rose-500"></span> API NOT FOUND';
                }
            } catch (e) { console.error(e); }
        }

        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            const bgCol = type === 'success' ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400' : 'bg-rose-500/10 border-rose-500/30 text-rose-400';
            toast.className = `glass ${bgCol} px-4 py-3 rounded-xl border text-xs font-medium shadow-2xl flex items-center gap-3 transition transform translate-y-2 opacity-0 duration-300`;
            toast.innerHTML = `<i class="fa-solid ${type === 'success' ? 'fa-circle-check' : 'fa-circle-exclamation'} text-base"></i><span>${message}</span>`;
            container.appendChild(toast);
            setTimeout(() => toast.classList.remove('translate-y-2', 'opacity-0'), 50);
            setTimeout(() => {
                toast.classList.add('translate-y-2', 'opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 4000);
        }

        function switchTab(tab) {
            ['dashboard', 'backtest', 'nodejs'].forEach(t => {
                document.getElementById(`tab-content-${t}`).classList.add('hidden');
                document.getElementById(`tab-btn-${t}`).className = 'py-3 text-xs font-bold uppercase tracking-wider text-gray-400 hover:text-white transition flex items-center gap-2 border-b-2 border-transparent';
            });
            document.getElementById(`tab-content-${tab}`).classList.remove('hidden');
            const activeColor = tab === 'nodejs' ? 'text-emerald-400 border-emerald-400' : 'text-cyan-400 border-cyan-400';
            document.getElementById(`tab-btn-${tab}`).className = `py-3 text-xs font-bold uppercase tracking-wider ${activeColor} transition flex items-center gap-2 border-b-2`;
        }

        function openConfigModal() { document.getElementById('config-modal').classList.toggle('hidden'); }

        async function saveConfig() {
            showToast('Konfigurasi Telegram & API VVIP berhasil disimpan!', 'success');
            openConfigModal();
            sendTelegramAlert("⚙️ *[CONFIG UPDATED]* Pengaturan VVIP Bot berhasil diperbarui!");
        }

        function changeMarketPair() {
            const val = document.getElementById('market-pair').value;
            currentPair = val;
            currentPrice = marketData[val].price;
            document.getElementById('metric-active-pair').innerText = marketData[val].name;
            document.getElementById('metric-price-live').innerText = formatIDR(currentPrice);
            addLog(`Market beralih ke ${marketData[val].name}. Harga: ${formatIDR(currentPrice)}`);
        }

        function updateStrategyDesc() {
            const strat = document.getElementById('strategy-select').value;
            const desc = document.getElementById('strategy-description');
            if(strat === 'ema_cross') desc.innerText = 'Trend following: Membeli saat EMA 9 memotong ke atas EMA 21 (Golden Cross).';
            else if(strat === 'macd_rsi') desc.innerText = 'Membeli saat MACD Golden Cross dan RSI di bawah 30 (Oversold).';
            else if(strat === 'bollinger') desc.innerText = 'Mean Reversion: Membeli di Bollinger Lower Band.';
        }

        function formatIDR(val) { return 'Rp ' + Math.round(val).toLocaleString('id-ID'); }

        function addLog(msg) {
            const terminal = document.getElementById('terminal-logs');
            const time = new Date().toLocaleTimeString();
            const div = document.createElement('div');
            div.className = 'text-gray-300';
            div.innerHTML = `<span class="text-gray-500">[${time}]</span> ${msg}`;
            terminal.prepend(div);
        }

        function clearLogs() { document.getElementById('terminal-logs').innerHTML = ''; }

        function startBot() {
            if(botState === 'RUNNING') return;
            botState = 'RUNNING';
            
            document.getElementById('btn-start').disabled = true;
            document.getElementById('btn-start').classList.add('opacity-50', 'cursor-not-allowed');
            document.getElementById('btn-pause').disabled = false;
            document.getElementById('btn-pause').classList.remove('opacity-50', 'cursor-not-allowed', 'bg-dark-700', 'text-gray-500');
            document.getElementById('btn-pause').classList.add('bg-amber-500', 'text-black');
            document.getElementById('btn-stop').disabled = false;
            document.getElementById('btn-stop').classList.remove('opacity-50', 'cursor-not-allowed');

            const badge = document.getElementById('bot-status-badge');
            badge.className = 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 px-3.5 py-1.5 rounded-xl text-xs font-semibold flex items-center gap-2';
            badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> RUNNING (VVIP)';

            showToast('VVIP Trading Bot Berhasil Dijalankan!', 'success');
            addLog(`[VVIP Start] Bot aktif di ${currentPair.toUpperCase()} dengan Trailing Stop & Telegram Webhook.`);
            sendTelegramAlert(`🟢 *[BOT STARTED]* VVIP Quant Bot aktif memantau market ${currentPair.toUpperCase()}!`);

            botInterval = setInterval(runBotTick, 3000);
        }

        function pauseBot() {
            if(botState === 'RUNNING') {
                botState = 'PAUSED';
                clearInterval(botInterval);
                document.getElementById('btn-start').disabled = false;
                document.getElementById('btn-start').classList.remove('opacity-50', 'cursor-not-allowed');
                document.getElementById('btn-pause').innerHTML = '<i class="fa-solid fa-play"></i> RESUME';
                showToast('Bot dijeda.', 'warning');
                sendTelegramAlert("⏸️ *[BOT PAUSED]* VVIP Quant Bot dijeda.");
            } else if(botState === 'PAUSED') {
                startBot();
                document.getElementById('btn-pause').innerHTML = '<i class="fa-solid fa-pause"></i> PAUSE';
            }
        }

        function stopBot() {
            botState = 'IDLE';
            clearInterval(botInterval);
            document.getElementById('btn-start').disabled = false;
            document.getElementById('btn-start').classList.remove('opacity-50', 'cursor-not-allowed');
            document.getElementById('btn-pause').disabled = true;
            document.getElementById('btn-pause').classList.add('opacity-50', 'cursor-not-allowed', 'bg-dark-700', 'text-gray-500');
            document.getElementById('btn-pause').classList.remove('bg-amber-500', 'text-black');
            document.getElementById('btn-stop').disabled = true;
            document.getElementById('btn-stop').classList.add('opacity-50', 'cursor-not-allowed');

            const badge = document.getElementById('bot-status-badge');
            badge.className = 'bg-amber-500/10 text-amber-400 border border-amber-500/30 px-3.5 py-1.5 rounded-xl text-xs font-semibold flex items-center gap-2';
            badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-amber-400"></span> IDLE';

            showToast('Bot dihentikan.', 'info');
            sendTelegramAlert("🛑 *[BOT STOPPED]* VVIP Quant Bot dihentikan.");
        }

        // Logika Inti Bot dengan Trailing Stop Mechanism
        function runBotTick() {
            const md = marketData[currentPair];
            const diff = (Math.random() - 0.48) * md.step;
            const oldPrice = currentPrice;
            currentPrice += diff;
            document.getElementById('metric-price-live').innerText = formatIDR(currentPrice);

            if(candleSeries) {
                let currentTime = Math.floor(Date.now() / 1000);
                let open = oldPrice;
                let close = currentPrice;
                let high = Math.max(open, close) + Math.random() * 20000;
                let low = Math.min(open, close) - Math.random() * 20000;
                candleSeries.update({ time: currentTime, open, high, low, close });
            }

            const alloc = parseFloat(document.getElementById('alloc-idr').value) || 5000000;
            const trailingOffsetPct = parseFloat(document.getElementById('param-trailing').value) || 0.5;
            const rand = Math.random();

            // Logika Posisi Terbuka & Trailing Stop
            if(cryptoBalance > 0) {
                if(currentPrice > peakPrice) {
                    peakPrice = currentPrice; // Catat harga tertinggi baru (Peak)
                }
                let trailingStopPrice = peakPrice * (1 - (trailingOffsetPct / 100));

                // Jika harga turun menembus batas trailing stop, lakukan SELL otomatis untuk kunci profit
                if(currentPrice <= trailingStopPrice) {
                    const val = cryptoBalance * currentPrice;
                    const pnl = val - alloc;
                    balanceIDR += val;
                    cryptoBalance = 0;
                    tradeCount++;
                    if(pnl >= 0) winCount++; else lossCount++;
                    addLog(`[TELEGRAM 📱] [TRAILING TAKE PROFIT] Terjual di ${formatIDR(currentPrice)}. P/L: ${formatIDR(pnl)}`);
                    sendTelegramAlert(`🛡️ *[TRAILING TAKE PROFIT]* Profit terkunci di ${formatIDR(currentPrice)}!\nP/L: ${formatIDR(pnl)}`);
                    peakPrice = 0;
                }
            }

            if(rand > 0.70 && balanceIDR >= alloc && cryptoBalance === 0) {
                balanceIDR -= alloc;
                cryptoBalance += (alloc / currentPrice);
                activePositionPrice = currentPrice;
                peakPrice = currentPrice; // Inisialisasi harga puncak awal
                tradeCount++;
                addLog(`[TELEGRAM 📱] [BUY VVIP] Membeli ${currentPair.toUpperCase()} @ ${formatIDR(currentPrice)} (Alokasi: ${formatIDR(alloc)})`);
                sendTelegramAlert(`🛒 *[BUY VVIP]* Membeli ${currentPair.toUpperCase()}\nHarga: ${formatIDR(currentPrice)}\nAlokasi: ${formatIDR(alloc)}`);
            } else if(rand < 0.25 && cryptoBalance > 0) {
                const val = cryptoBalance * currentPrice;
                const pnl = val - alloc;
                balanceIDR += val;
                cryptoBalance = 0;
                tradeCount++;
                if(pnl >= 0) winCount++; else lossCount++;
                addLog(`[TELEGRAM 📱] [SELL SIGNAL] Keluar posisi normal. P/L: ${formatIDR(pnl)}`);
                sendTelegramAlert(`💰 *[SELL SIGNAL]* Posisi ditutup.\nHarga: ${formatIDR(currentPrice)}\nP/L: ${formatIDR(pnl)}`);
            }

            const totalEq = balanceIDR + (cryptoBalance * currentPrice);
            equityData.push(totalEq);
            if(equityData.length > 20) equityData.shift();

            updateMetrics(totalEq);
            updateChart();
        }

        function updateMetrics(totalEq) {
            const pnl = totalEq - initialBalance;
            const pnlPct = (pnl / initialBalance) * 100;
            const pnlEl = document.getElementById('metric-pnl');
            pnlEl.innerText = `${pnl >= 0 ? '+' : ''}${formatIDR(pnl)} (${pnlPct.toFixed(2)}%)`;
            pnlEl.className = `text-lg font-bold mono mt-2 ${pnl >= 0 ? 'text-emerald-400' : 'text-rose-400'}`;

            const winRate = tradeCount > 0 ? (winCount / tradeCount) * 100 : 0;
            document.getElementById('metric-winrate').innerText = winRate.toFixed(1) + '%';
            document.getElementById('metric-win-loss').innerText = `Wins: ${winCount} | Losses: ${lossCount}`;
            document.getElementById('nav-total-equity').innerText = formatIDR(totalEq);
        }

        function initChart() {
            const ctx = document.getElementById('equityChart').getContext('2d');
            chartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: equityData.map((_, i) => i),
                    datasets: [{
                        label: 'VVIP Portfolio Equity',
                        data: equityData,
                        borderColor: '#06b6d4',
                        backgroundColor: 'rgba(6, 182, 212, 0.1)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.3,
                        pointRadius: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { color: 'rgba(255,255,255,0.03)' }, ticks: { color: '#6b7280', font: { size: 10 } } },
                        y: { grid: { color: 'rgba(255,255,255,0.03)' }, ticks: { color: '#6b7280', font: { size: 10 } } }
                    }
                }
            });
        }

        function updateChart() {
            if(!chartInstance) return;
            chartInstance.data.labels = equityData.map((_, i) => i);
            chartInstance.data.datasets[0].data = equityData;
            chartInstance.update('none');
        }

        function runBacktest() { 
            showToast('Simulasi backtest VVIP dengan Trailing Stop sukses!', 'success'); 
            sendTelegramAlert("📈 *[BACKTEST COMPLETE]* Simulasi kinerja historis 30 hari sukses dijalankan!");
        }

        function copyNodeCode() {
            const codeText = document.getElementById('nodejs-code-text').innerText;
            if(navigator.clipboard) navigator.clipboard.writeText(codeText);
            showToast('Script VVIP Node.js berhasil disalin!', 'success');
        }
    </script>
</body>
</html>